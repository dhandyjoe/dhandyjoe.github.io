---
const links = [
  {
    id: 'top',
    label: 'Home',
    icon: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/>',
  },
  {
    id: 'projects',
    label: 'Projects',
    icon: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/>',
  },
  {
    id: 'about',
    label: 'About Me',
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  },
  {
    id: 'contact',
    label: 'Contact',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  },
];
---

<header class="topnav">
  <nav aria-label="Primary">
    <div class="dock glass tt">
      {links.map((l, i) => (
        <a
          class:list={['dock-item', i === 0 && 'is-active']}
          href={`#${l.id}`}
          aria-current={i === 0 ? 'true' : undefined}
        >
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={l.icon}
          />
          <span class="lbl">{l.label}</span>
        </a>
      ))}
    </div>
    <button
      class="themebtn glass tt"
      type="button"
      id="theme-toggle"
      aria-label="Switch to dark theme"
      title="Switch theme"
    >
      <svg
        class="icon-in sun"
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2" />
        <path d="M12 20v2" />
        <path d="M4.9 4.9l1.4 1.4" />
        <path d="M17.7 17.7l1.4 1.4" />
        <path d="M2 12h2" />
        <path d="M20 12h2" />
        <path d="M4.9 19.1l1.4-1.4" />
        <path d="M17.7 6.3l1.4-1.4" />
      </svg>
      <svg
        class="icon-in moon"
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle') as HTMLButtonElement;

  function syncLabel() {
    toggle.setAttribute(
      'aria-label',
      root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  }
  syncLabel();
  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncLabel();
  });

  // Scrollspy: highlight the dock item of the section crossing the middle of the viewport.
  const items = [...document.querySelectorAll<HTMLAnchorElement>('.dock-item')];
  const sections = items.map((a) => document.getElementById(a.hash.slice(1))!);
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const a of items) {
          const on = a.hash === `#${e.target.id}`;
          a.classList.toggle('is-active', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((s) => spy.observe(s));

  // Home goes to the real top; the #top section starts below the sticky nav, so the anchor would stop short of it.
  items[0]?.addEventListener('click', (e) => {
    e.preventDefault();
    history.replaceState(null, '', '#top');
    window.scrollTo({ top: 0 });
  });
</script>
