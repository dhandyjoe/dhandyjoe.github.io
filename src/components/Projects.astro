---
import SparkleIcon from './SparkleIcon.astro';
import SplitText from './SplitText.astro';
import StickFigure from './StickFigure.astro';
import { categories, projects } from '../data/projects';

const filters = ['All', ...categories].map((label) => ({
  label,
  count: label === 'All' ? projects.length : projects.filter((p) => (p.cats as readonly string[]).includes(label)).length,
}));
const items = projects.map((p, i) => ({ ...p, num: String(i + 1).padStart(2, '0') }));
---

<section id="projects" class="projects" aria-labelledby="projects-h">
  <div class="projects-in">
    <div class="projects-head">
      <div class="projects-title">
        <span class="label">01 / Projects</span>
        <h2 id="projects-h" class="h-big">
          <span class="sr">Projects</span>
          <span class="word" aria-hidden="true">
            <StickFigure variant="walker" class="walker" />
            <SplitText text="Projects" />
          </span>
          <sup aria-hidden="true" id="shown-count">
            ({projects.length})
          </sup>
        </h2>
      </div>
      <div class="tabs" role="group" aria-label="Filter projects">
        {filters.map((f) => (
          <button
            class="tab"
            type="button"
            data-filter={f.label}
            aria-pressed={f.label === 'All' ? 'true' : 'false'}
          >
            {f.label === 'Vibe Coding' && <SparkleIcon />}
            <span>{f.label}</span>
            <span class="n">{f.count}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="sr" role="status" id="filter-status"></p>
    <div class="cards">
      {items.map((p) => (
        <a
          class="card reveal"
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          data-cats={p.cats.join('|')}
        >
          <div class="card-top">
            <span class="muted num">
              {p.num} — {p.cats.join(' · ')}
              {p.cats.includes('Vibe Coding') && (
                <span class="ai-tag">
                  <SparkleIcon />
                  AI-built
                </span>
              )}
            </span>
            <span class="arrow" aria-hidden="true">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14" />
                <path d="M13 6l6 6-6 6" />
              </svg>
            </span>
          </div>
          <div class="card-body">
            <span class="title">{p.title}</span>
            <span class="muted kind">
              {p.kind} · {p.linkLabel}
              <span class="sr">(opens in a new tab)</span>
            </span>
            <div class="ticker muted" aria-hidden="true">
              <div class="ticker-in">
                {[0, 1, 2, 3].flatMap(() => [
                  <span>Open {p.linkLabel} ↗</span>,
                  <span>{p.title}</span>,
                ])}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab')];
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const count = document.getElementById('shown-count')!;
  const status = document.getElementById('filter-status')!;

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter;
      let shown = 0;
      for (const c of cards) {
        const show = filter === 'All' || c.dataset.cats!.split('|').includes(filter!);
        c.hidden = !show;
        if (show) shown++;
      }
      for (const t of tabs) t.setAttribute('aria-pressed', String(t === tab));
      count.textContent = `(${shown})`;
      status.textContent = `Showing ${shown} ${filter === 'All' ? '' : filter + ' '}projects`;
    });
  }
</script>
