---
// The little animated QA stick figure. peek = hero, walker = projects title, wave = contact title.
interface Props {
  variant: 'peek' | 'walker' | 'wave';
  class?: string;
}
const { variant, class: cls = '' } = Astro.props;
const sizes = {
  peek: ['0.36em', '0.52em'],
  walker: ['0.3em', '0.44em'],
  wave: ['0.32em', '0.46em'],
} as const;
const [w, h] = sizes[variant];
---

<svg
  class:list={['stick', variant, cls]}
  aria-hidden="true"
  viewBox="0 0 44 64"
  fill="none"
  stroke="currentColor"
  stroke-width="3.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={`width:${w};height:${h}`}
>
  {variant === 'peek' && (
    <g transform="translate(44 0) scale(-1 1)">
      <circle cx="18" cy="10" r="7" />
      <line x1="18" y1="17" x2="18" y2="40" />
      <line x1="18" y1="40" x2="10" y2="62" />
      <line x1="18" y1="40" x2="26" y2="62" />
      <line x1="18" y1="25" x2="7" y2="34" />
      <g class="lens">
        <line x1="18" y1="25" x2="31" y2="18" />
        <circle cx="36" cy="14" r="6" style="fill:var(--accent)" />
      </g>
    </g>
  )}
  {variant === 'walker' && (
    <g class="bob">
      <circle cx="20" cy="10" r="7" />
      <line x1="20" y1="17" x2="20" y2="40" />
      <line class="armSwing" x1="20" y1="24" x2="12" y2="35" />
      <g class="lens2">
        <line x1="20" y1="24" x2="31" y2="27" />
        <circle cx="36" cy="27" r="5" style="fill:var(--accent)" />
      </g>
      <line class="legA" x1="20" y1="40" x2="12" y2="62" />
      <line class="legB" x1="20" y1="40" x2="28" y2="62" />
    </g>
  )}
  {variant === 'wave' && (
    <g class="bob">
      <circle cx="20" cy="10" r="7" />
      <line x1="20" y1="17" x2="20" y2="40" />
      <line x1="20" y1="40" x2="12" y2="62" />
      <line x1="20" y1="40" x2="28" y2="62" />
      <line x1="20" y1="24" x2="9" y2="34" />
      <g class="wave-arm">
        <line x1="20" y1="24" x2="33" y2="11" />
        <circle cx="35" cy="9" r="3.5" style="fill:var(--accent);stroke:none" />
      </g>
    </g>
  )}
</svg>

<style>
  .peek,
  .walker {
    color: var(--fg);
  }
  .wave {
    color: #edebe3;
    margin-left: 0.12em;
    margin-bottom: 0.06em;
  }
  .peek {
    margin-left: 0.08em;
    margin-bottom: 0.04em;
  }
  @media (max-width: 760px) {
    .stick {
      stroke-width: 4;
    }
  }
</style>
